<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title || 'Expense Splitter' %></title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="container">
    <h1><%= title || 'Expense Splitter' %></h1>
    
   <div style="text-align: center; margin-bottom: 2rem; display: flex; gap: 1rem; justify-content: center; align-items: center;">
      <a href="/add-user" class="btn-primary" style="margin: 0;">+ Add User</a>
      <a href="/add-expense" class="btn-primary" style="margin: 0;">+ Add Expense</a>
      
      <form action="/reset" method="POST" style="margin: 0;">
        <button type="submit" class="btn-primary" onclick="return confirm('🚨 NUCLEAR WARNING: Are you sure you want to wipe EVERYTHING? This will permanently delete all expenses AND all users. This cannot be undone.')" style="background-color: #dc3545; margin: 0; font-family: inherit; font-weight: bold;">
          Reset Everything
        </button>
      </form>
    </div>

    <% if (settlement && settlement.length > 0) { %>
      <h2>Settlement Plan</h2>
      <p style="margin-bottom: 1rem; color: #666;">
        Minimum transactions to settle all debts:
      </p>
      <div class="settlement-list">
        <% settlement.forEach(transaction => { %>
          <div class="settlement-item">
            <strong><%= transaction.from %></strong> owes
            <strong><%= transaction.to %></strong>
            <span class="settlement-amount">₹ <%= transaction.amount.toFixed(2) %></span>
          </div>
        <% }) %>
      </div>
    <% } %>

    <h2>Group Members</h2>
    <% if (users && users.length > 0) { %>
      <div class="members-list">
        <% users.forEach(user => { %>
          <div class="member-card">
            <strong><%= user.name %></strong> 
          </div>
        <% }) %>
      </div>
    <% } else { %>
      <div class="empty-state">No house members found.</div>
    <% } %>

    <h2>Expense History</h2>
    <% if (expenses && expenses.length > 0) { %>
      <table class="expense-table">
        <thead>
          <tr>
            <th>ID</th>
            <th>Description</th>
            <th>Amount</th>
            <th>Paid By</th>
            <th>Date</th>
            <th>Actions</th> 
          </tr>
        </thead>
        <tbody>
          <% expenses.forEach(expense => { %>
            <tr>
              <td><%= expense.id %></td>
              <td><%= expense.description %></td>
              <td class="amount">₹ <%= parseFloat(expense.totalAmount).toFixed(2) %></td>
              <td><%= users.find(u => u.id === expense.paidByUserId)?.name || 'Unknown User' %></td>
              <td class="date"><%= new Date(expense.date).toLocaleDateString() %></td>
              <td>
                <form action="/delete-expense/<%= expense.id %>" method="POST" style="display:inline;">
                  <button type="submit" onclick="return confirm('Are you sure you want to delete this expense? This will recalculate all debts.')" style="color: white; background-color: #ff4d4f; border: none; padding: 5px 10px; border-radius: 4px; cursor: pointer; font-size: 0.9em;">
                    Delete
                  </button>
                </form>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    <% } else { %>
      <div class="empty-state">No expenses recorded yet.</div>
    <% } %>
  </div>
</body>
</html>